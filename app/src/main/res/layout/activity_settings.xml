<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neob_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/neob_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="@string/settings"
            app:titleTextAppearance="@style/TextAppearance.AkbarTime.Heading2"
            app:titleTextColor="@color/neob_text" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Location Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/location"
                android:textAppearance="@style/TextAppearance.AkbarTime.Heading2"
                android:textSize="16sp"
                android:textColor="@color/neob_text" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_neob_card"
                android:paddingBottom="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_city"
                        android:textAppearance="@style/TextAppearance.AkbarTime.Caption"
                        android:textColor="@color/neob_text" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxStrokeWidth="2.5dp"
                        app:boxStrokeColor="@color/neob_border"
                        app:hintEnabled="false">

                        <AutoCompleteTextView
                            android:id="@+id/autoCompleteCities"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_neob_card"
                            android:hint="Cari kota..."
                            android:inputType="text"
                            android:padding="12dp"
                            android:textAppearance="@style/TextAppearance.AkbarTime.BodyMedium"
                            android:textColor="@color/neob_text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetectLocation"
                        style="@style/Widget.AkbarTime.NeobButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/detect_location"
                        app:icon="@android:drawable/ic_menu_mylocation"
                        app:iconTint="@color/neob_text" />
                </LinearLayout>
            </FrameLayout>

            <!-- Notification Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/adzan_sound"
                android:textAppearance="@style/TextAppearance.AkbarTime.Heading2"
                android:textSize="16sp"
                android:textColor="@color/neob_text" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_neob_card"
                android:paddingBottom="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:id="@+id/adzanToggleContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">
                </LinearLayout>
            </FrameLayout>

            <!-- Manual Correction Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/manual_correction_title"
                android:textAppearance="@style/TextAppearance.AkbarTime.Heading2"
                android:textSize="16sp"
                android:textColor="@color/neob_text" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_neob_card"
                android:paddingBottom="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:id="@+id/correctionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">
                </LinearLayout>
            </FrameLayout>

            <!-- Pre-Reminder & Silent Mode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Fitur Tambahan"
                android:textAppearance="@style/TextAppearance.AkbarTime.Heading2"
                android:textSize="16sp"
                android:textColor="@color/neob_text" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_neob_card"
                android:paddingBottom="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <include
                        android:id="@+id/layoutPreReminder"
                        layout="@layout/item_setting_toggle" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/neob_border"
                        android:layout_marginHorizontal="16dp" />

                    <include
                        android:id="@+id/layoutSilentMode"
                        layout="@layout/item_setting_toggle" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/neob_border"
                        android:layout_marginHorizontal="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestAlarm"
                        style="@style/Widget.AkbarTime.NeobButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:text="Test Notifikasi &amp; Adzan"
                        app:icon="@android:drawable/ic_lock_idle_alarm"
                        app:iconTint="@color/neob_text" />
                </LinearLayout>
            </FrameLayout>

            <!-- Reliability Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/battery_optimize_title"
                android:textAppearance="@style/TextAppearance.AkbarTime.Heading2"
                android:textSize="16sp"
                android:textColor="@color/neob_text" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_neob_card"
                android:paddingBottom="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_optimize_label"
                        android:textAppearance="@style/TextAppearance.AkbarTime.BodyMedium"
                        android:textStyle="bold"
                        android:textColor="@color/neob_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/battery_optimize_desc"
                        android:textAppearance="@style/TextAppearance.AkbarTime.Caption"
                        android:textColor="@color/neob_text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBatteryOptimize"
                        style="@style/Widget.AkbarTime.NeobButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/btn_open_battery_settings"
                        app:icon="@android:drawable/ic_lock_power_off"
                        app:iconTint="@color/neob_text" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/neob_card"
        app:itemIconTint="@color/neob_text"
        app:itemTextColor="@color/neob_text"
        app:itemRippleColor="@color/neob_primary"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
