<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neob_background"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/greeting_assalamualaikum"
                        android:textAppearance="@style/TextAppearance.AkbarTime.Caption"
                        android:textColor="@color/neob_text" />
                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jakarta, Indonesia"
                        android:textAppearance="@style/TextAppearance.AkbarTime.Heading2"
                        android:textSize="16sp"
                        android:textColor="@color/neob_text" />
                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 September 2026 • 24 Safar 1448"
                        android:textAppearance="@style/TextAppearance.AkbarTime.Caption"
                        android:textColor="@color/neob_text"
                        android:alpha="0.7" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Main Card -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_neob_primary_card"
                android:paddingBottom="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvNextPrayerLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib"
                        android:textAppearance="@style/TextAppearance.AkbarTime.Heading1"
                        android:textColor="@color/neob_text" />

                    <TextView
                        android:id="@+id/tvCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:45:12"
                        android:textAppearance="@style/TextAppearance.AkbarTime.Heading1"
                        android:textSize="40sp"
                        android:textColor="@color/neob_text" />

                    <TextView
                        android:id="@+id/tvNextPrayerTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18:02"
                        android:textAppearance="@style/TextAppearance.AkbarTime.BodyMedium"
                        android:textColor="@color/neob_text"
                        android:alpha="0.8" />
                </LinearLayout>

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:src="@drawable/heroat"
                    android:alpha="0.8" />
            </FrameLayout>

            <!-- Prayer List -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/prayer_schedule_today"
                android:textAppearance="@style/TextAppearance.AkbarTime.Heading2"
                android:textColor="@color/neob_text" />

            <LinearLayout
                android:id="@+id/prayerListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Imsak -->
                <include layout="@layout/item_prayer_time" android:id="@+id/itemImsak" />
                <!-- Subuh -->
                <include layout="@layout/item_prayer_time" android:id="@+id/itemSubuh" />
                <!-- Dhuha -->
                <include layout="@layout/item_prayer_time" android:id="@+id/itemDhuha" />
                <!-- Dzuhur -->
                <include layout="@layout/item_prayer_time" android:id="@+id/itemDzuhur" />
                <!-- Ashar -->
                <include layout="@layout/item_prayer_time" android:id="@+id/itemAshar" />
                <!-- Maghrib -->
                <include layout="@layout/item_prayer_time" android:id="@+id/itemMaghrib" />
                <!-- Isya -->
                <include layout="@layout/item_prayer_time" android:id="@+id/itemIsya" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/neob_card"
        app:itemIconTint="@color/neob_text"
        app:itemTextColor="@color/neob_text"
        app:itemRippleColor="@color/neob_primary"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
