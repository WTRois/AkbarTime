<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow shrinks/disappears on press -->
            <item android:left="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neob_border" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neob_primary_hover" />
                    <stroke android:width="2.5dp" android:color="@color/neob_border" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default state -->
    <item>
        <layer-list>
            <item android:left="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neob_border" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/neob_primary" />
                    <stroke android:width="2.5dp" android:color="@color/neob_border" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
