<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AkbarTime" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/neob_primary</item>
        <item name="colorSecondary">@color/neob_primary</item>
        <item name="colorSurface">@color/neob_background</item>
        <item name="android:windowBackground">@color/neob_background</item>
        <item name="android:statusBarColor">@color/neob_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- Global font (Poppins for all body text) -->
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <!-- theme-neob specific styles -->
    <style name="Widget.AkbarTime.NeobCard" parent="">
        <item name="android:background">@drawable/bg_neob_card</item>
    </style>

    <style name="Widget.AkbarTime.NeobButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_neob_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/neob_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="Theme.AkbarTime" parent="Base.Theme.AkbarTime" />

    <!-- Typography -->
    <style name="TextAppearance.AkbarTime.Heading1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AkbarTime.Heading2" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/sora</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AkbarTime.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.AkbarTime.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
